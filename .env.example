# Copy this file to ".env" and fill in your real values.
# Never commit your real ".env" file to GitHub.

SECRET_KEY=change-this-to-a-random-string

# --- Gmail SMTP example ---
# 1. Turn on 2-Factor Authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords and create an "App Password"
# 3. Use that 16-character app password below (NOT your real Gmail password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
[email protected]
MAIL_PASSWORD=your-16-char-app-password
[email protected]

# Reminder rules
FEE_REMINDER_DAYS_BEFORE=3
TASK_REMINDER_DAYS_BEFORE=2
LOW_ATTENDANCE_THRESHOLD=75

# Time of day the automatic daily reminder job runs (24-hour format)
REMINDER_HOUR=8
REMINDER_MINUTE=0
